{
  "manifest_version": 3,
  "name": "DKCL Báo cáo BĐHN",
  "version": "1.2.3",
  "description": "Lấy dữ liệu KPI DKCL BĐHN từ dkcl.vnpost.vn và xuất Excel theo tỉnh hoặc bưu cục.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DKCL Báo cáo BĐHN",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "host_permissions": ["https://dkcl.vnpost.vn/*"],
  "content_scripts": [
    {
      "matches": ["https://dkcl.vnpost.vn/*"],
      "js": ["content-sidebar.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js", "icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"],
      "matches": ["https://dkcl.vnpost.vn/*"]
    }
  ]
}
