      <Row><Cell ss:MergeAcross="43" ss:StyleID="Title"><Data ss:Type="String">🏆 SUPER EXECUTIVE BI DASHBOARD - CHUỖI XU HƯỚNG MA TRẬN ĐA THÁNG &amp; LŨY KẾ BQ (Tháng 01/2026 ➔ Tháng 08/2026)</Data></Cell></Row>
      <Row><Cell ss:MergeAcross="43" ss:StyleID="Text"><Data ss:Type="String">Đơn vị trọng điểm: Thừa Thiên Huế (Mã 53)  |  Tổng số đối sánh: 34 Bưu điện Tỉnh/TP  |  Theo dõi biến động 8 tháng liên tục</Data></Cell></Row>
      <Row></Row>

      <!-- KHỐI 1: EXEC CARDS TIÊU ĐIỂM ĐƠN VỊ ĐƯỢC CHỌN -->
      <Row ss:Height="22"><Cell ss:MergeAcross="9" ss:StyleID="ProvCard1Title"><Data ss:Type="String">1. SL LŨY KẾ F1.1 (Bưu điện Tỉnh Thừa Thiên Huế)</Data></Cell><Cell ss:MergeAcross="9" ss:StyleID="ProvCard2Title"><Data ss:Type="String">2. TỶ LỆ BQ F1.1 (Bưu điện Tỉnh Thừa Thiên Huế)</Data></Cell><Cell ss:MergeAcross="9" ss:StyleID="ProvCard3Title"><Data ss:Type="String">1. SL LŨY KẾ F1.2 (Bưu điện Tỉnh Thừa Thiên Huế)</Data></Cell><Cell ss:MergeAcross="12" ss:StyleID="ProvCard4Title"><Data ss:Type="String">2. TỶ LỆ BQ F1.2 (Bưu điện Tỉnh Thừa Thiên Huế)</Data></Cell></Row>
      <Row ss:Height="38"><Cell ss:MergeAcross="9" ss:StyleID="ProvCard1Val"><Data ss:Type="String">377.392 bưu gửi&#10;(Hạng 8/34 toàn quốc)</Data></Cell><Cell ss:MergeAcross="9" ss:StyleID="ProvCard2Val"><Data ss:Type="String">73.11%&#10;(MoM: -10.18% | Hạng 8/34 toàn quốc)</Data></Cell><Cell ss:MergeAcross="9" ss:StyleID="ProvCard3Val"><Data ss:Type="String">365.084 bưu gửi&#10;(Hạng 11/34 toàn quốc)</Data></Cell><Cell ss:MergeAcross="12" ss:StyleID="ProvCard4Val"><Data ss:Type="String">82.69%&#10;(MoM: -2.17% | Hạng 11/34 toàn quốc)</Data></Cell></Row>
      <Row ss:Height="22"><Cell ss:MergeAcross="9" ss:StyleID="ProvCard1Title"><Data ss:Type="String">1. SL LŨY KẾ F1.3 (Bưu điện Tỉnh Thừa Thiên Huế)</Data></Cell><Cell ss:MergeAcross="9" ss:StyleID="ProvCard2Title"><Data ss:Type="String">2. TỶ LỆ BQ F1.3 (Bưu điện Tỉnh Thừa Thiên Huế)</Data></Cell><Cell ss:MergeAcross="9" ss:StyleID="ProvCard3Title"><Data ss:Type="String">1. SL LŨY KẾ F4.1 (Bưu điện Tỉnh Thừa Thiên Huế)</Data></Cell><Cell ss:MergeAcross="12" ss:StyleID="ProvCard4Title"><Data ss:Type="String">2. TỶ LỆ BQ F4.1 (Bưu điện Tỉnh Thừa Thiên Huế)</Data></Cell></Row>
      <Row ss:Height="38"><Cell ss:MergeAcross="9" ss:StyleID="ProvCard1Val"><Data ss:Type="String">751.549 bưu gửi&#10;(Hạng 17/34 toàn quốc)</Data></Cell><Cell ss:MergeAcross="9" ss:StyleID="ProvCard2Val"><Data ss:Type="String">55.65%&#10;(MoM: -9.45% | Hạng 17/34 toàn quốc)</Data></Cell><Cell ss:MergeAcross="9" ss:StyleID="ProvCard3Val"><Data ss:Type="String">1.098.267 bưu gửi&#10;(Hạng 5/34 toàn quốc)</Data></Cell><Cell ss:MergeAcross="12" ss:StyleID="ProvCard4Val"><Data ss:Type="String">55.24%&#10;(MoM: +20.86% | Hạng 5/34 toàn quốc)</Data></Cell></Row>
