      <Row><Cell ss:MergeAcross="10" ss:StyleID="Title"><Data ss:Type="String">🏆 SUPER EXECUTIVE BI DASHBOARD - VỊ THẾ &amp; CHẤT LƯỢNG BƯU ĐIỆN TỈNH THỪA THIÊN HUẾ (MÃ 53)</Data></Cell></Row>
      <Row><Cell ss:MergeAcross="10" ss:StyleID="Text"><Data ss:Type="String">Kỳ báo cáo: 25/08/2026 - 25/08/2026  |  Kỳ so sánh: 24/08/2026 - 24/08/2026  |  Đối sánh 34 Đơn vị Toàn quốc</Data></Cell></Row>
      <Row></Row>

      <!-- KHỐI 1: 4 THẺ CHỈ ĐẠO BAN GIÁM ĐỐC TỈNH -->
      <Row ss:Height="22">
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard1Title"><Data ss:Type="String">1. XẾP HẠNG TỔNG THỂ TOÀN QUỐC</Data></Cell>
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard2Title"><Data ss:Type="String">2. TỶ LỆ CHẤT LƯỢNG BQ TỈNH</Data></Cell>
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard3Title"><Data ss:Type="String">3. CHỈ SỐ MŨI NHỌN BỨT PHÁ</Data></Cell>
        <Cell ss:MergeAcross="1" ss:StyleID="ProvCard4Title"><Data ss:Type="String">4. ĐIỂM NGHẼN NGUY CƠ RỦI RO</Data></Cell>
      </Row>
      <Row ss:Height="38">
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard1Val"><Data ss:Type="String">HẠNG 9 / 34 TOÀN QUỐC&#10;(📈 Thăng +2 bậc, từ Hạng 11 ➔ Hạng 9)</Data></Cell>
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard2Val"><Data ss:Type="String">68.99%&#10;(📈 +7.83% so với kỳ trước 61.15%)</Data></Cell>
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard3Val"><Data ss:Type="String">F4.1 – PTC Truyền thống&#10;(74.52% - 📈 +19.32%, Hạng 10/34)</Data></Cell>
        <Cell ss:MergeAcross="1" ss:StyleID="ProvCard4Val"><Data ss:Type="String">🚨 F1.2 – Thu gom đi liên tỉnh&#10;(76.49% - 📉 -10.85%, Hạng 30/34)</Data></Cell>
      </Row>
      <Row></Row>

      <!-- KHỐI 2: MA TRẬN PHÂN TÍCH CHẤT LƯỢNG KÉP & DỊCH CHUYỂN THỨ HẠNG -->
      <Row><Cell ss:MergeAcross="10" ss:StyleID="Group"><Data ss:Type="String">BẢNG PHÂN TÍCH SO SÁNH 360°: TỶ LỆ CHẤT LƯỢNG KÉP (%) &amp; DỊCH CHUYỂN THỨ HẠNG (34 ĐƠN VỊ TOÀN QUỐC)</Data></Cell></Row>
      <Row>
        <Cell ss:StyleID="Header"><Data ss:Type="String">STT</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Chỉ số chất lượng KPI</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Tỷ lệ Kỳ này</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Biểu đồ Tỷ lệ</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Tỷ lệ Kỳ trước</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Biến động Tỷ lệ</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Biểu đồ Biến động</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Hạng Kỳ này</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Hạng Kỳ trước</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Dịch chuyển Thứ hạng</Data></Cell>
        <Cell ss:StyleID="Header"><Data ss:Type="String">Phân loại Vị thế BI</Data></Cell>
      </Row>

      <!-- ROWS DATA -->
      <Row>
        <Cell ss:StyleID="Number"><Data ss:Type="Number">1</Data></Cell>
        <Cell ss:StyleID="Text"><Data ss:Type="String">F4.1 – PTC TMĐT</Data></Cell>
        <Cell ss:StyleID="Percent"><Data ss:Type="Number">0.4245</Data></Cell>
        <Cell ss:StyleID="Text"><Data ss:Type="String">████░░░░░░ 42.4%</Data></Cell>
        <Cell ss:StyleID="Percent"><Data ss:Type="Number">0.3794</Data></Cell>
        <Cell ss:StyleID="Up"><Data ss:Type="String">tăng 4.50 điểm %, từ 37.94% lên 42.45%</Data></Cell>
        <Cell ss:StyleID="Up"><Data ss:Type="String">📈 █████ +4.50%</Data></Cell>
        <Cell ss:StyleID="Text"><Data ss:Type="String">11 / 34</Data></Cell>
        <Cell ss:StyleID="Text"><Data ss:Type="String">12 / 34</Data></Cell>
        <Cell ss:StyleID="Up"><Data ss:Type="String">🟢 ▲ Tăng 1 bậc (Hạng 12 ➔ 11)</Data></Cell>
        <Cell ss:StyleID="RankUp"><Data ss:Type="String">📈 TIẾN BỘ (Thăng hạng tích cực)</Data></Cell>
      </Row>

      <Row>
        <Cell ss:StyleID="Number"><Data ss:Type="Number">2</Data></Cell>
