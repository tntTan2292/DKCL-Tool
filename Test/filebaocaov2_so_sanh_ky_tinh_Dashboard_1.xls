        <Cell ss:StyleID="Up"><Data ss:Type="String">tăng 19.32 điểm %, từ 55.21% lên 74.52%</Data></Cell>
        <Cell ss:StyleID="Up"><Data ss:Type="String">📈 ████████ +19.32%</Data></Cell>
        <Cell ss:StyleID="Text"><Data ss:Type="String">10 / 34</Data></Cell>
        <Cell ss:StyleID="Text"><Data ss:Type="String">12 / 34</Data></Cell>
        <Cell ss:StyleID="Up"><Data ss:Type="String">🟢 ▲ Tăng 2 bậc (Hạng 12 ➔ 10)</Data></Cell>
