  <Worksheet ss:Name="Dashboard_53">
    <Table>
      <Column ss:Width="46"/><Column ss:Width="200"/><Column ss:Width="100"/><Column ss:Width="130"/><Column ss:Width="100"/><Column ss:Width="190"/><Column ss:Width="150"/><Column ss:Width="100"/><Column ss:Width="100"/><Column ss:Width="160"/><Column ss:Width="240"/>
      <Row><Cell ss:MergeAcross="10" ss:StyleID="Title"><Data ss:Type="String">🏆 SUPER EXECUTIVE BI DASHBOARD - VỊ THẾ &amp; CHẤT LƯỢNG THỪA THIÊN HUẾ (MÃ 53)</Data></Cell></Row>
      <Row><Cell ss:MergeAcross="10" ss:StyleID="Text"><Data ss:Type="String">Kỳ báo cáo: 08/27/2026 - 08/27/2026  |  Kỳ so sánh: 08/26/2026 - 08/26/2026  |  Đối sánh 34 Đơn vị Toàn quốc</Data></Cell></Row>
      <Row></Row>

      <!-- KHỐI 1: 4 WIDGETS CHỈ TIÊU CỐT LÕI (F1.1, F1.2, F1.3, F4.1) -->
      <Row ss:Height="22">
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard1Title"><Data ss:Type="String">1. F1.1 – NỘI TỈNH</Data></Cell>
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard2Title"><Data ss:Type="String">2. F1.2 – THU GOM ĐI LIÊN TỈNH</Data></Cell>
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard3Title"><Data ss:Type="String">3. F1.3 – PHÁT LIÊN TỈNH</Data></Cell>
        <Cell ss:MergeAcross="1" ss:StyleID="ProvCard4Title"><Data ss:Type="String">4. F4.1 – PHÁT THÀNH CÔNG BƯU CỤC</Data></Cell>
      </Row>
      <Row ss:Height="38">
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard1Val"><Data ss:Type="String">81.05%&#10;(📈 +0.88%  |  Hạng 19/34 toàn quốc)</Data></Cell>
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard2Val"><Data ss:Type="String">82.07%&#10;(📉 -1.55%  |  Hạng 46/34 toàn quốc)</Data></Cell>
        <Cell ss:MergeAcross="2" ss:StyleID="ProvCard3Val"><Data ss:Type="String">54.78%&#10;(📉 -14.68%  |  Hạng 31/34 toàn quốc)</Data></Cell>
        <Cell ss:MergeAcross="1" ss:StyleID="ProvCard4Val"><Data ss:Type="String">58.52%&#10;(📉 -12.35%  |  Hạng 25/34 toàn quốc)</Data></Cell>
      </Row>
      <Row></Row>

      <!-- KHỐI 2: MA TRẬN PHÂN TÍCH CHẤT LƯỢNG KÉP & DỊCH CHUYỂN THỨ HẠNG -->
      <Row><Cell ss:MergeAcross="10" ss:StyleID="Group"><Data ss:Type="String">BẢNG PHÂN TÍCH SO SÁNH 360°: TỶ LỆ CHẤT LƯỢNG KÉP (%) &amp; DỊCH CHUYỂN THỨ HẠNG (34 ĐƠN VỊ TOÀN QUỐC)</Data></Cell></Row>
      <Row><Cell ss:StyleID="Header"><Data ss:Type="String">STT</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Chỉ số chất lượng KPI</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Tỷ lệ Kỳ này</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Biểu đồ Tỷ lệ</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Tỷ lệ Kỳ trước</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Biến động Tỷ lệ</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Biểu đồ Biến động</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Hạng Kỳ này</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Hạng Kỳ trước</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Dịch chuyển Thứ hạng</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Phân loại Vị thế BI</Data></Cell></Row>
      <Row>
          <Cell ss:StyleID="Number"><Data ss:Type="Number">1</Data></Cell>
          <Cell ss:StyleID="Text"><Data ss:Type="String">F4.1 – Chất lượng phát thành công tại bưu cục</Data></Cell>
          <Cell ss:StyleID="Percent"><Data ss:Type="Number">0.5852422080360495</Data></Cell>
          <Cell ss:StyleID="Text"><Data ss:Type="String">██████░░░░ 58.5%</Data></Cell>
          <Cell ss:StyleID="Percent"><Data ss:Type="Number">0.7087428867046043</Data></Cell>
          <Cell ss:StyleID="Down"><Data ss:Type="String">giảm 12,35 điểm %, từ 70,87% xuống 58,52%</Data></Cell>
          <Cell ss:StyleID="Down"><Data ss:Type="String">📉 ████████ -12.35%</Data></Cell>
          <Cell ss:StyleID="Text"><Data ss:Type="String">25 / 34</Data></Cell>
